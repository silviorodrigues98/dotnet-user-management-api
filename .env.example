# Modelo de variáveis de ambiente do docker-compose (D-09).
# Copie para .env com: cp .env.example .env  — e troque os valores abaixo por segredos reais.
# O arquivo .env real NUNCA é versionado (gitignored).
#
# Gere uma chave aleatória com: openssl rand -hex 32
JWT__KEY=changeme-troque-por-uma-chave-aleatoria-de-ao-menos-32-bytes

# Credenciais do PostgreSQL (gerar com: openssl rand -hex 16)
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dotnet_user_management